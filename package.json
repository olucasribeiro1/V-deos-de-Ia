{
  "name": "hora-a-hora-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Estúdio de animação 3D POV (Cinematic Stylized Low Poly) — Remotion + React Three Fiber",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/remotion/index.ts",
    "typecheck": "tsc --noEmit",
