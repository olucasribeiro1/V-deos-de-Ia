{
  "name": "hora-a-hora-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Est\u00fadio de anima\u00e7\u00e3o 3D POV (Cinematic Stylized Low Poly) \u2014 Remotion + React Three Fiber",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/remotion/index.ts",
    "typecheck": "tsc --noEmit",
    "voice": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/generate-voice/generate.mjs",
    "sfx": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/generate-voice/sfx.mjs",
    "validate": "NODE_NO_WARNINGS=1 node --import ./scripts/lib/ts-register.mjs scripts/validate-assets/validate.mjs",
    "render": "NODE_NO_WARNINGS=1 node --import ./scripts/lib/ts-register.mjs scripts/render-episode/render.mjs",
    "still": "remotion still src/remotion/index.ts",
    "voice:speed": "node scripts/generate-voice/speed.mjs",
    "audit:float": "NODE_NO_WARNINGS=1 node --import ./scripts/lib/ts-register.mjs scripts/validate-assets/float-audit.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "@remotion/three": "4.0.545",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.545",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.187.0",
    "typescript": "5.9.3"
  }
}
