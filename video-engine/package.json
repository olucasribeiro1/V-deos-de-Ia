{
  "name": "video-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion engine for the vertical animated shorts (O Salto)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:teste": "remotion render src/index.ts Teste20s out/teste-20s-video.mp4 --codec=h264 --muted --concurrency=4",
    "still": "remotion still src/index.ts Teste20s",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/oswald": "5.3.0",
    "@fontsource/roboto-condensed": "5.3.0",
    "@remotion/cli": "4.0.539",
    "@remotion/fonts": "4.0.539",
    "@remotion/noise": "4.0.539",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.9.3"
  }
}
