[
 {
  "i": 0,
  "start": 0.785,
  "end": 1.3,
  "text": "Dia quinze."
 },
 {
  "i": 1,
  "start": 1.467,
  "end": 3.223,
  "text": "O Bilu limpo, água nos galões..."
 },
 {
  "i": 2,
  "start": 3.244,
  "end": 5.406,
  "text": "e uma pergunta que ninguém consegue mais engolir."
 },
 {
  "i": 3,
  "start": 5.97,
  "end": 6.334,
  "text": "Mariana."
 },
 {
  "i": 4,
  "start": 6.552,
  "end": 7.17,
  "text": "Senta."
 },
 {
  "i": 5,
  "start": 7.352,
  "end": 8.372,
  "text": "E conta tudo."
 },
 {
  "i": 6,
  "start": 8.739,
  "end": 10.272,
  "text": "Ela respira fundo."
 },
 {
  "i": 7,
  "start": 10.539,
  "end": 12.839,
  "text": "E pela primeira vez desde a bomba..."
 },
 {
  "i": 8,
  "start": 13.139,
  "end": 14.411,
  "text": "não desvia o olhar."
 },
 {
  "i": 9,
  "start": 14.836,
  "end": 16.457,
  "text": "Eu sou biomédica do Exército."
 },
 {
  "i": 10,
  "start": 16.602,
  "end": 19.548,
  "text": "Trabalhei seis anos num laboratório de biossegurança."
 },
 {
  "i": 11,
  "start": 19.73,
  "end": 21.631,
  "text": "Num projeto chamado Cérebro."
 },
 {
  "i": 12,
  "start": 21.942,
  "end": 23.847,
  "text": "O Projeto Cérebro estudava um organismo."
 },
 {
  "i": 13,
  "start": 24.014,
  "end": 24.914,
  "text": "Uma coisa que aprende."
 },
 {
  "i": 14,
  "start": 25.014,
  "end": 25.781,
  "text": "Que se adapta."
 },
 {
  "i": 15,
  "start": 25.814,
  "end": 28.258,
  "text": "E que age em grupo, como se fosse um cérebro só."
 },
 {
  "i": 16,
  "start": 28.303,
  "end": 28.887,
  "text": "Por isso o nome."
 },
 {
  "i": 17,
  "start": 29.282,
  "end": 31.319,
  "text": "Duas semanas antes da bomba..."
 },
 {
  "i": 18,
  "start": 31.392,
  "end": 32.992,
  "text": "ele escapou da contenção."
 },
 {
  "i": 19,
  "start": 33.266,
  "end": 35.266,
  "text": "E o comando tomou uma decisão."
 },
 {
  "i": 20,
  "start": 35.626,
  "end": 37.99,
  "text": "A bomba não foi ataque de inimigo nenhum."
 },
 {
  "i": 21,
  "start": 38.244,
  "end": 40.28,
  "text": "Foi ordem do nosso próprio comando."
 },
 {
  "i": 22,
  "start": 40.317,
  "end": 41.735,
  "text": "Uma arma experimental."
 },
 {
  "i": 23,
  "start": 41.76,
  "end": 43.927,
  "text": "Pra queimar tudo antes que aquilo se espalhasse."
 },
 {
  "i": 24,
  "start": 44.234,
  "end": 45.443,
  "text": "Ela sabia da operação."
 },
 {
  "i": 25,
  "start": 45.51,
  "end": 46.333,
  "text": "Sabia o dia."
 },
 {
  "i": 26,
  "start": 46.354,
  "end": 47.777,
  "text": "E não podia contar pra ninguém."
 },
 {
  "i": 27,
  "start": 47.821,
  "end": 48.781,
  "text": "Nem pro próprio irmão."
 },
 {
  "i": 28,
  "start": 49.285,
  "end": 51.431,
  "text": "Então você deixou a gente quase morrer..."
 },
 {
  "i": 29,
  "start": 51.504,
  "end": 52.376,
  "text": "calada?"
 },
 {
  "i": 30,
  "start": 52.703,
  "end": 57.867,
  "text": "Eu só podia fazer uma coisa dentro da lei: nunca desmentir a paranoia do seu tio."
 },
 {
  "i": 31,
  "start": 58.242,
  "end": 62.531,
  "text": "Por oito anos, a piada da família foi o único aviso que ela conseguiu dar."
 },
 {
  "i": 32,
  "start": 62.552,
  "end": 64.742,
  "text": "Cada lata, cada galão desse bunker..."
 },
 {
  "i": 33,
  "start": 64.775,
  "end": 66.008,
  "text": "ela ajudou a pagar."
 },
 {
  "i": 34,
  "start": 66.042,
  "end": 66.842,
  "text": "Escondido."
 },
 {
  "i": 35,
  "start": 67.292,
  "end": 68.273,
  "text": "Era você..."
 },
 {
  "i": 36,
  "start": 68.528,
  "end": 70.564,
  "text": "o dinheiro na minha caixa de correio."
 },
 {
  "i": 37,
  "start": 70.934,
  "end": 73.978,
  "text": "Foi ela também que pôs iodeto de potássio no kit de primeiros socorros."
 },
 {
  "i": 38,
  "start": 74.023,
  "end": 77.101,
  "text": "Mas atenção: ele só protege a tireoide do iodo radioativo."
 },
 {
  "i": 39,
  "start": 77.134,
  "end": 78.717,
  "text": "Não é remédio contra radiação."
 },
 {
  "i": 40,
  "start": 78.767,
  "end": 80.076,
  "text": "Quem salva é o abrigo."
 },
 {
  "i": 41,
  "start": 80.807,
  "end": 81.385,
  "text": "Então..."
 },
 {
  "i": 42,
  "start": 81.567,
  "end": 83.822,
  "text": "pelo menos a bomba resolveu o problema, né?"
 },
 {
  "i": 43,
  "start": 84.473,
  "end": 85.928,
  "text": "Ele sobreviveu."
 },
 {
  "i": 44,
  "start": 86.555,
  "end": 88.166,
  "text": "E nesse exato momento..."
 },
 {
  "i": 45,
  "start": 88.266,
  "end": 89.966,
  "text": "tem passos em cima do alçapão."
 },
 {
  "i": 46,
  "start": 94.509,
  "end": 96.576,
  "text": "Segue a página pra ver o episódio oito!"
 }
]