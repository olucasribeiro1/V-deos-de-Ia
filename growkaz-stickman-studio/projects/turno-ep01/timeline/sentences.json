[
 {
  "i": 0,
  "start": 0.241,
  "end": 1.481,
  "text": "Aí passou um carro."
 },
 {
  "i": 1,
  "start": 1.681,
  "end": 2.681,
  "text": "Na contramão."
 },
 {
  "i": 2,
  "start": 2.881,
  "end": 3.801,
  "text": "Sem farol."
 },
 {
  "i": 3,
  "start": 4.081,
  "end": 6.274,
  "text": "Arrastando alguma coisa no para-choque."
 },
 {
  "i": 4,
  "start": 10.12,
  "end": 11.84,
  "text": "Mais uma noite de serviço."
 },
 {
  "i": 5,
  "start": 12.12,
  "end": 15.72,
  "text": "Três da manhã, cafeteira pingando, geladeira zumbindo."
 },
 {
  "i": 6,
  "start": 16.28,
  "end": 17.72,
  "text": "Eu repondo bolacha..."
 },
 {
  "i": 7,
  "start": 17.76,
  "end": 19.8,
  "text": "e o Tico fazendo o que ele faz de melhor."
 },
 {
  "i": 8,
  "start": 20.29,
  "end": 22.912,
  "text": "Coxinha que passa da meia-noite é perda, Lucas."
 },
 {
  "i": 9,
  "start": 22.936,
  "end": 24.369,
  "text": "Eu tô salvando a empresa."
 },
 {
  "i": 10,
  "start": 25.109,
  "end": 28.709,
  "text": "Só que naquela noite a BR tava quieta demais."
 },
 {
  "i": 11,
  "start": 28.789,
  "end": 31.269,
  "text": "Duas horas sem passar um caminhão."
 },
 {
  "i": 12,
  "start": 32.039,
  "end": 34.706,
  "text": "Pô, até os caminhoneiros tiraram folga."
 },
 {
  "i": 13,
  "start": 34.854,
  "end": 36.411,
  "text": "Só nós dois de otário aqui."
 },
 {
  "i": 14,
  "start": 37.091,
  "end": 38.331,
  "text": "Aí passou um carro."
 },
 {
  "i": 15,
  "start": 38.531,
  "end": 39.531,
  "text": "Na contramão."
 },
 {
  "i": 16,
  "start": 39.731,
  "end": 40.651,
  "text": "Sem farol."
 },
 {
  "i": 17,
  "start": 40.931,
  "end": 43.124,
  "text": "Arrastando alguma coisa no para-choque."
 },
 {
  "i": 18,
  "start": 44.165,
  "end": 45.572,
  "text": "Isso aí era um..."
 },
 {
  "i": 19,
  "start": 45.609,
  "end": 46.461,
  "text": "saco de lixo."
 },
 {
  "i": 20,
  "start": 46.906,
  "end": 47.357,
  "text": "Né?"
 },
 {
  "i": 21,
  "start": 48.077,
  "end": 49.117,
  "text": "Não era."
 },
 {
  "i": 22,
  "start": 49.867,
  "end": 51.924,
  "text": "Alerta do Ministério da Saúde."
 },
 {
  "i": 23,
  "start": 52.289,
  "end": 56.689,
  "text": "Surtos de agressividade e febre alta na região metropolitana."
 },
 {
  "i": 24,
  "start": 57.054,
  "end": 58.757,
  "text": "Evitem contato físico."
 },
 {
  "i": 25,
  "start": 58.956,
  "end": 61.146,
  "text": "Permaneçam em locais fechados."
 },
 {
  "i": 26,
  "start": 61.904,
  "end": 63.089,
  "text": "Mais uma gripe."
 },
 {
  "i": 27,
  "start": 63.311,
  "end": 65.769,
  "text": "Na última eu fiquei rico vendendo álcool em gel."
 },
 {
  "i": 28,
  "start": 66.449,
  "end": 68.209,
  "text": "Aí o Seu Alberto entrou."
 },
 {
  "i": 29,
  "start": 68.449,
  "end": 70.249,
  "text": "Toda semana ele para aqui."
 },
 {
  "i": 30,
  "start": 70.529,
  "end": 71.929,
  "text": "Mas ele tava branco."
 },
 {
  "i": 31,
  "start": 72.129,
  "end": 72.889,
  "text": "Suando."
 },
 {
  "i": 32,
  "start": 73.089,
  "end": 75.851,
  "text": "Com um pano amarrado no braço, encharcado."
 },
 {
  "i": 33,
  "start": 77.751,
  "end": 78.871,
  "text": "Me vê um café, filho."
 },
 {
  "i": 34,
  "start": 79.351,
  "end": 81.831,
  "text": "Um louco tentou abrir a porta do caminhão no pedágio."
 },
 {
  "i": 35,
  "start": 82.151,
  "end": 83.544,
  "text": "Me mordeu, acredita?"
 }
]