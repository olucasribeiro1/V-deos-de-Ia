[
 {
  "i": 0,
  "start": 0.667,
  "end": 1.4,
  "text": "Dia dezesseis."
 },
 {
  "i": 1,
  "start": 1.533,
  "end": 2.167,
  "text": "Dezessete."
 },
 {
  "i": 2,
  "start": 2.333,
  "end": 2.8,
  "text": "Vinte."
 },
 {
  "i": 3,
  "start": 3.0,
  "end": 4.667,
  "text": "Os passos voltam toda noite..."
 },
 {
  "i": 4,
  "start": 4.733,
  "end": 6.142,
  "text": "e vão embora toda madrugada."
 },
 {
  "i": 5,
  "start": 6.409,
  "end": 10.475,
  "text": "Até que, no dia vinte e dois, o rádio chia com uma voz nova."
 },
 {
  "i": 6,
  "start": 10.79,
  "end": 14.319,
  "text": "Atenção, sobreviventes da zona de contenção."
 },
 {
  "i": 7,
  "start": 14.737,
  "end": 17.129,
  "text": "Evacuação no estádio municipal."
 },
 {
  "i": 8,
  "start": 17.547,
  "end": 19.416,
  "text": "Dia trinta, meio-dia."
 },
 {
  "i": 9,
  "start": 19.683,
  "end": 21.1,
  "text": "Último helicóptero."
 },
 {
  "i": 10,
  "start": 21.472,
  "end": 22.709,
  "text": "Estádio municipal..."
 },
 {
  "i": 11,
  "start": 22.745,
  "end": 24.309,
  "text": "é a três quilômetros daqui!"
 },
 {
  "i": 12,
  "start": 24.588,
  "end": 28.661,
  "text": "Três quilômetros a pé, de dia, com aquela coisa caçando calor."
 },
 {
  "i": 13,
  "start": 29.025,
  "end": 30.991,
  "text": "A gente brilha feito uma fogueira."
 },
 {
  "i": 14,
  "start": 31.563,
  "end": 34.282,
  "text": "Então a gente dá pra ela uma fogueira maior."
 },
 {
  "i": 15,
  "start": 34.548,
  "end": 36.748,
  "text": "E é aí que a piada da família vira arma."
 },
 {
  "i": 16,
  "start": 36.792,
  "end": 37.615,
  "text": "A churrasqueira."
 },
 {
  "i": 17,
  "start": 37.648,
  "end": 38.815,
  "text": "O depósito de carvão."
 },
 {
  "i": 18,
  "start": 38.882,
  "end": 40.493,
  "text": "Oito anos de carvão estocado."
 },
 {
  "i": 19,
  "start": 40.827,
  "end": 42.656,
  "text": "No dia trinta, a gente acende tudo."
 },
 {
  "i": 20,
  "start": 42.693,
  "end": 45.638,
  "text": "Brasa no máximo, gerador ligado do lado de fora, esquentando."
 },
 {
  "i": 21,
  "start": 45.711,
  "end": 46.656,
  "text": "Ele vem pro calor."
 },
 {
  "i": 22,
  "start": 46.681,
  "end": 47.89,
  "text": "E a gente vai pro outro lado."
 },
 {
  "i": 23,
  "start": 48.163,
  "end": 50.926,
  "text": "Ele sempre vai na fonte mais quente."
 },
 {
  "i": 24,
  "start": 51.036,
  "end": 52.963,
  "text": "Mais quente que quatro corpos..."
 },
 {
  "i": 25,
  "start": 52.999,
  "end": 53.981,
  "text": "e um cachorro."
 },
 {
  "i": 26,
  "start": 54.348,
  "end": 55.487,
  "text": "Uma semana de preparação."
 },
 {
  "i": 27,
  "start": 55.62,
  "end": 59.82,
  "text": "Mochila de fuga pra cada um: água, comida, lanterna, rádio, remédio, documento..."
 },
 {
  "i": 28,
  "start": 59.853,
  "end": 60.62,
  "text": "e um apito."
 },
 {
  "i": 29,
  "start": 60.72,
  "end": 63.554,
  "text": "Apito é o jeito mais barato de pedir socorro sem gastar a voz."
 },
 {
  "i": 30,
  "start": 63.877,
  "end": 65.331,
  "text": "Posso levar o guaraná?"
 },
 {
  "i": 31,
  "start": 65.78,
  "end": 66.507,
  "text": "Não."
 },
 {
  "i": 32,
  "start": 66.828,
  "end": 68.828,
  "text": "Rota marcada no mapa, longe da avenida."
 },
 {
  "i": 33,
  "start": 68.895,
  "end": 70.828,
  "text": "Sinal combinado: um apito, para."
 },
 {
  "i": 34,
  "start": 70.861,
  "end": 72.046,
  "text": "Dois apitos, corre."
 },
 {
  "i": 35,
  "start": 72.68,
  "end": 76.832,
  "text": "Mas na última noite, o tio faz a conta que ninguém queria fazer."
 },
 {
  "i": 36,
  "start": 77.423,
  "end": 80.223,
  "text": "A brasa apaga em meia hora se ninguém alimentar."
 },
 {
  "i": 37,
  "start": 80.259,
  "end": 81.496,
  "text": "Alguém tem que ficar."
 },
 {
  "i": 38,
  "start": 81.826,
  "end": 83.208,
  "text": "Tio, não..."
 },
 {
  "i": 39,
  "start": 83.648,
  "end": 86.059,
  "text": "Eu passei a vida esperando esse dia, Eduardo."
 },
 {
  "i": 40,
  "start": 86.132,
  "end": 87.516,
  "text": "Me deixa terminar o serviço."
 },
 {
  "i": 41,
  "start": 92.05,
  "end": 94.05,
  "text": "Segue a página pra ver o último episódio!"
 }
]