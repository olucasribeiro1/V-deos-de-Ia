[
 {
  "i": 0,
  "start": 2.36,
  "end": 3.8,
  "text": "O que é isso?"
 },
 {
  "i": 1,
  "start": 5.926,
  "end": 6.886,
  "text": "Nossa..."
 },
 {
  "i": 2,
  "start": 6.926,
  "end": 8.366,
  "text": "eu tô muito apertada."
 },
 {
  "i": 3,
  "start": 8.566,
  "end": 10.246,
  "text": "Três quarteirões até em casa."
 },
 {
  "i": 4,
  "start": 10.406,
  "end": 11.686,
  "text": "Não vou aguentar."
 },
 {
  "i": 5,
  "start": 13.116,
  "end": 14.076,
  "text": "Metrô."
 },
 {
  "i": 6,
  "start": 14.636,
  "end": 16.076,
  "text": "Graças a Deus."
 },
 {
  "i": 7,
  "start": 16.316,
  "end": 18.076,
  "text": "Todo metrô tem banheiro..."
 },
 {
  "i": 8,
  "start": 18.196,
  "end": 18.626,
  "text": "né?"
 },
 {
  "i": 9,
  "start": 24.786,
  "end": 26.346,
  "text": "Ai, que nojo..."
 },
 {
  "i": 10,
  "start": 26.546,
  "end": 28.626,
  "text": "Papel em volta do vaso."
 },
 {
  "i": 11,
  "start": 28.706,
  "end": 30.216,
  "text": "Ninguém morre disso."
 },
 {
  "i": 12,
  "start": 34.796,
  "end": 39.476,
  "text": "Minha vó dizia que espelho velho guarda o último rosto que viu..."
 },
 {
  "i": 13,
  "start": 39.756,
  "end": 43.586,
  "text": "e que, de vez em quando, devolve o rosto errado."
 },
 {
  "i": 14,
  "start": 45.066,
  "end": 46.986,
  "text": "Quando a luz voltou..."
 },
 {
  "i": 15,
  "start": 47.066,
  "end": 51.226,
  "text": "eu jurei que o meu reflexo demorou meio segundo pra piscar."
 },
 {
  "i": 16,
  "start": 52.656,
  "end": 54.096,
  "text": "O que é isso?"
 },
 {
  "i": 17,
  "start": 57.721,
  "end": 59.201,
  "text": "Cadê todo mundo?"
 },
 {
  "i": 18,
  "start": 59.481,
  "end": 62.601,
  "text": "Dez minutos atrás essa rua era um formigueiro."
 },
 {
  "i": 19,
  "start": 65.513,
  "end": 67.051,
  "text": "Ninguém falava nada."
 },
 {
  "i": 20,
  "start": 67.331,
  "end": 69.251,
  "text": "Eles só viravam a cabeça."
 },
 {
  "i": 21,
  "start": 69.491,
  "end": 70.451,
  "text": "Devagar."
 },
 {
  "i": 22,
  "start": 70.691,
  "end": 71.801,
  "text": "Me seguindo."
 },
 {
  "i": 23,
  "start": 73.721,
  "end": 74.841,
  "text": "Moça..."
 },
 {
  "i": 24,
  "start": 74.881,
  "end": 76.281,
  "text": "você é daqui?"
 },
 {
  "i": 25,
  "start": 76.934,
  "end": 78.134,
  "text": "Claro que sou."
 },
 {
  "i": 26,
  "start": 78.924,
  "end": 80.324,
  "text": "Velha doida."
 },
 {
  "i": 27,
  "start": 82.374,
  "end": 84.854,
  "text": "Então por que tá com cheiro de lá?"
 },
 {
  "i": 28,
  "start": 88.598,
  "end": 90.038,
  "text": "Cheguei, vida!"
 },
 {
  "i": 29,
  "start": 90.278,
  "end": 92.758,
  "text": "Nossa, hoje foi estranho..."
 },
 {
  "i": 30,
  "start": 94.839,
  "end": 95.919,
  "text": "Silêncio."
 },
 {
  "i": 31,
  "start": 96.199,
  "end": 98.269,
  "text": "Nem a geladeira fazia barulho."
 },
 {
  "i": 32,
  "start": 100.849,
  "end": 102.449,
  "text": "Aquela não era eu."
 },
 {
  "i": 33,
  "start": 102.769,
  "end": 103.969,
  "text": "E o Diego..."
 },
 {
  "i": 34,
  "start": 104.009,
  "end": 107.169,
  "text": "tava olhando pra câmera igual àquelas pessoas da rua."
 },
 {
  "i": 35,
  "start": 108.999,
  "end": 110.519,
  "text": "Cheguei, vida!"
 },
 {
  "i": 36,
  "start": 112.831,
  "end": 114.271,
  "text": "Segue a página..."
 },
 {
  "i": 37,
  "start": 114.351,
  "end": 115.951,
  "text": "pro episódio dois."
 }
]