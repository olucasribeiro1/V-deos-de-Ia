[
 {
  "i": 0,
  "start": 0.787,
  "end": 1.467,
  "text": "Dia catorze."
 },
 {
  "i": 1,
  "start": 1.6,
  "end": 3.867,
  "text": "Trezentas e trinta e seis horas depois da bomba."
 },
 {
  "i": 2,
  "start": 3.911,
  "end": 7.476,
  "text": "Pela regra do tio, a radiação lá fora caiu pra zero vírgula um por cento."
 },
 {
  "i": 3,
  "start": 8.137,
  "end": 8.985,
  "text": "Protocolo de saída."
 },
 {
  "i": 4,
  "start": 9.13,
  "end": 12.549,
  "text": "Capa de chuva, máscara, luva, saco plástico no pé."
 },
 {
  "i": 5,
  "start": 12.621,
  "end": 14.44,
  "text": "Nenhum pedaço de pele pra fora."
 },
 {
  "i": 6,
  "start": 14.476,
  "end": 15.458,
  "text": "Vinte minutos."
 },
 {
  "i": 7,
  "start": 15.53,
  "end": 16.41,
  "text": "Nem um a mais."
 },
 {
  "i": 8,
  "start": 16.677,
  "end": 18.144,
  "text": "Vão o tio, o Eduardo..."
 },
 {
  "i": 9,
  "start": 18.21,
  "end": 19.883,
  "text": "e o Rafael, que se recusou a ficar."
 },
 {
  "i": 10,
  "start": 20.156,
  "end": 24.012,
  "text": "Se for pra arriscar a vida, eu quero pelo menos o pão de queijo do freezer."
 },
 {
  "i": 11,
  "start": 24.235,
  "end": 26.926,
  "text": "Rafael, o mundo pode ter acabado."
 },
 {
  "i": 12,
  "start": 27.37,
  "end": 28.534,
  "text": "Mais um motivo."
 },
 {
  "i": 13,
  "start": 29.007,
  "end": 31.807,
  "text": "O alçapão abre pela primeira vez em duas semanas."
 },
 {
  "i": 14,
  "start": 32.007,
  "end": 33.74,
  "text": "O quintal tá irreconhecível."
 },
 {
  "i": 15,
  "start": 33.94,
  "end": 36.949,
  "text": "Tudo coberto de uma poeira cinza, fina feito talco."
 },
 {
  "i": 16,
  "start": 37.216,
  "end": 40.149,
  "text": "Missão um: mangueira na caixa d'água, direto pros galões."
 },
 {
  "i": 17,
  "start": 40.249,
  "end": 41.63,
  "text": "Missão dois: o freezer."
 },
 {
  "i": 18,
  "start": 41.976,
  "end": 43.503,
  "text": "Meu pão de queijo..."
 },
 {
  "i": 19,
  "start": 43.576,
  "end": 45.046,
  "text": "virou uma pedra mole!"
 },
 {
  "i": 20,
  "start": 45.413,
  "end": 46.013,
  "text": "E aí..."
 },
 {
  "i": 21,
  "start": 46.213,
  "end": 47.013,
  "text": "um latido."
 },
 {
  "i": 22,
  "start": 47.213,
  "end": 47.78,
  "text": "Fraco."
 },
 {
  "i": 23,
  "start": 47.946,
  "end": 48.892,
  "text": "Debaixo da casa."
 },
 {
  "i": 24,
  "start": 49.26,
  "end": 50.06,
  "text": "BILU!"
 },
 {
  "i": 25,
  "start": 50.513,
  "end": 53.18,
  "text": "Magro, sujo, cinza da cabeça ao rabo..."
 },
 {
  "i": 26,
  "start": 53.38,
  "end": 54.118,
  "text": "mas vivo."
 },
 {
  "i": 27,
  "start": 54.718,
  "end": 57.385,
  "text": "Só que no muro, do lado da churrasqueira..."
 },
 {
  "i": 28,
  "start": 57.485,
  "end": 58.318,
  "text": "marcas de garra."
 },
 {
  "i": 29,
  "start": 58.718,
  "end": 59.251,
  "text": "Fundas."
 },
 {
  "i": 30,
  "start": 59.585,
  "end": 61.461,
  "text": "Do chão até quase dois metros."
 },
 {
  "i": 31,
  "start": 61.807,
  "end": 62.716,
  "text": "Ninguém corre."
 },
 {
  "i": 32,
  "start": 62.898,
  "end": 63.843,
  "text": "Ninguém grita."
 },
 {
  "i": 33,
  "start": 63.916,
  "end": 64.691,
  "text": "Pra dentro."
 },
 {
  "i": 34,
  "start": 64.74,
  "end": 65.37,
  "text": "Agora."
 },
 {
  "i": 35,
  "start": 65.742,
  "end": 68.909,
  "text": "Na volta, protocolo: a roupa de fora fica do lado de fora."
 },
 {
  "i": 36,
  "start": 68.942,
  "end": 71.675,
  "text": "Só isso tira até noventa por cento da poeira radioativa."
 },
 {
  "i": 37,
  "start": 71.742,
  "end": 73.375,
  "text": "Depois, banho com sabão e xampu."
 },
 {
  "i": 38,
  "start": 73.409,
  "end": 75.498,
  "text": "Condicionador não, porque gruda a poeira no cabelo."
 },
 {
  "i": 39,
  "start": 75.519,
  "end": 76.109,
  "text": "E o Bilu?"
 },
 {
  "i": 40,
  "start": 76.142,
  "end": 76.744,
  "text": "Banho também."
 },
 {
  "i": 41,
  "start": 77.211,
  "end": 79.977,
  "text": "No meio da correria, a mochila da mãe cai da escada."
 },
 {
  "i": 42,
  "start": 80.144,
  "end": 82.211,
  "text": "Papéis do Exército se espalham pelo chão."
 },
 {
  "i": 43,
  "start": 82.311,
  "end": 84.411,
  "text": "Projeto Cérebro, em letras vermelhas."
 },
 {
  "i": 44,
  "start": 84.477,
  "end": 85.544,
  "text": "E um desenho..."
 },
 {
  "i": 45,
  "start": 85.577,
  "end": 87.479,
  "text": "de uma coisa que não devia existir."
 },
 {
  "i": 46,
  "start": 87.997,
  "end": 88.652,
  "text": "Mãe..."
 },
 {
  "i": 47,
  "start": 88.688,
  "end": 89.597,
  "text": "o que é isso?"
 },
 {
  "i": 48,
  "start": 90.184,
  "end": 92.784,
  "text": "E dessa vez, ela não tenta esconder."
 },
 {
  "i": 49,
  "start": 93.051,
  "end": 94.551,
  "text": "Ela só olha pro filho..."
 },
 {
  "i": 50,
  "start": 94.584,
  "end": 96.461,
  "text": "como quem finalmente desiste."
 },
 {
  "i": 51,
  "start": 101.027,
  "end": 103.061,
  "text": "Segue a página pra ver o episódio sete!"
 }
]