   "end": 47.606,
   "file": "projects/ep02-racao-de-guerra/input/clips/nx2_b5e9105ade.mp3"
  },
  {
   "id": "n3",
   "spk": "NARRADOR",
   "text": "Osvaldo tenta captar alguma frequência. A maior parte é estática.",
   "start": 48.406,
   "end": 53.448,
   "file": "projects/ep02-racao-de-guerra/input/clips/n3_9a3bb8e822.mp3"
  },
  {
   "id": "rad",
   "spk": "RADIO",
   "text": "Contenção do Projeto Cérberu não foi concluída.",
