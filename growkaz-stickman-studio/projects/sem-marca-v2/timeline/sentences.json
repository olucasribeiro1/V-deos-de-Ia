[
 {
  "i": 0,
  "start": 0.362,
  "end": 1.808,
  "text": "Você morreu salvando um gato."
 },
 {
  "i": 1,
  "start": 1.962,
  "end": 2.332,
  "text": "Sério."
 },
 {
  "i": 2,
  "start": 2.488,
  "end": 7.663,
  "text": "O bichano tava parado no meio da avenida, o caminhão vinha voando, e você nem pensou: pulou, empurrou o gato pra calçada..."
 },
 {
  "i": 3,
  "start": 7.878,
  "end": 9.109,
  "text": "O gato saiu ileso."
 },
 {
  "i": 4,
  "start": 9.294,
  "end": 9.971,
  "text": "Você..."
 },
 {
  "i": 5,
  "start": 10.032,
  "end": 10.97,
  "text": "virou estatística."
 },
 {
  "i": 6,
  "start": 11.435,
  "end": 12.213,
  "text": "Aí você abre o olho."
 },
 {
  "i": 7,
  "start": 12.366,
  "end": 14.182,
  "text": "Céu azul, duas luas lá em cima..."
 },
 {
  "i": 8,
  "start": 14.213,
  "end": 16.93,
  "text": "e um dragão do tamanho de um prédio passa raspando na sua cabeça."
 },
 {
  "i": 9,
  "start": 17.103,
  "end": 18.272,
  "text": "Eita, P*RRA!"
 },
 {
  "i": 10,
  "start": 18.858,
  "end": 19.412,
  "text": "É, parceiro."
 },
 {
  "i": 11,
  "start": 19.474,
  "end": 20.848,
  "text": "Você foi parar em outro mundo."
 },
 {
  "i": 12,
  "start": 20.868,
  "end": 23.765,
  "text": "E na sua frente aparece uma tela, igual de videogame: Nível zero."
 },
 {
  "i": 13,
  "start": 23.888,
  "end": 26.165,
  "text": "Força dez, velocidade oito, inteligência doze."
 },
 {
  "i": 14,
  "start": 26.227,
  "end": 27.519,
  "text": "Matou monstro, tudo sobe."
 },
 {
  "i": 15,
  "start": 27.55,
  "end": 28.934,
  "text": "Menos uma coisa: a magia."
 },
 {
  "i": 16,
  "start": 28.996,
  "end": 30.233,
  "text": "Essa tá travada no zero."
 },
 {
  "i": 17,
  "start": 30.546,
  "end": 32.792,
  "text": "Esse mundo se chama Aldoria e tem quatro nações."
 },
 {
  "i": 18,
  "start": 32.812,
  "end": 34.7,
  "text": "No norte, os elfos: arco e cura."
 },
 {
  "i": 19,
  "start": 34.72,
  "end": 37.12,
  "text": "Nas montanhas, os anões, os melhores ferreiros que existem."
 },
 {
  "i": 20,
  "start": 37.162,
  "end": 39.377,
  "text": "No centro, o reino humano, governado pelo Rei Mago."
 },
 {
  "i": 21,
  "start": 39.397,
  "end": 40.987,
  "text": "E no sul, de onde ninguém volta..."
 },
 {
  "i": 22,
  "start": 41.018,
  "end": 41.941,
  "text": "o Rei Demônio."
 },
 {
  "i": 23,
  "start": 42.199,
  "end": 44.255,
  "text": "E aqui todo mundo nasce com uma marca no rosto."
 },
 {
  "i": 24,
  "start": 44.275,
  "end": 45.035,
  "text": "Uma linha?"
 },
 {
  "i": 25,
  "start": 45.219,
  "end": 45.445,
  "text": "Elite."
 },
 {
  "i": 26,
  "start": 45.486,
  "end": 45.865,
  "text": "Duas?"
 },
 {
  "i": 27,
  "start": 45.896,
  "end": 46.922,
  "text": "Soldado, ferreiro."
 },
 {
  "i": 28,
  "start": 46.963,
  "end": 47.394,
  "text": "Três?"
 },
 {
  "i": 29,
  "start": 47.414,
  "end": 49.533,
  "text": "Trabalho pesado, e ninguém nem olha na sua cara."
 },
 {
  "i": 30,
  "start": 49.69,
  "end": 50.843,
  "text": "E a cor é o elemento."
 },
 {
  "i": 31,
  "start": 50.925,
  "end": 51.94,
  "text": "Vermelha, fogo."
 },
 {
  "i": 32,
  "start": 51.971,
  "end": 52.863,
  "text": "Azul, água."
 },
 {
  "i": 33,
  "start": 52.894,
  "end": 53.838,
  "text": "Marrom, terra."
 },
 {
  "i": 34,
  "start": 53.858,
  "end": 54.71,
  "text": "Branca, vento."
 },
 {
  "i": 35,
  "start": 54.74,
  "end": 55.746,
  "text": "Amarela, raio."
 },
 {
  "i": 36,
  "start": 55.766,
  "end": 59.106,
  "text": "E a dourada, a mais rara de todas, só o próprio Rei Mago tem."
 },
 {
  "i": 37,
  "start": 59.368,
  "end": 61.429,
  "text": "Aí você corre até um lago, se olha na água..."
 },
 {
  "i": 38,
  "start": 61.46,
  "end": 62.106,
  "text": "e nada."
 },
 {
  "i": 39,
  "start": 62.137,
  "end": 62.845,
  "text": "Rosto liso."
 },
 {
  "i": 40,
  "start": 62.875,
  "end": 63.737,
  "text": "Nenhuma marca."
 },
 {
  "i": 41,
  "start": 63.798,
  "end": 64.445,
  "text": "Ferrou."
 },
 {
  "i": 42,
  "start": 64.475,
  "end": 67.922,
  "text": "Na cidade, todo mundo te encara: criança aponta, guarda já põe a mão na lança."
 },
 {
  "i": 43,
  "start": 68.129,
  "end": 70.134,
  "text": "Te levam pra Academia Real, pro Teste do Cristal."
 },
 {
  "i": 44,
  "start": 70.287,
  "end": 72.657,
  "text": "O garoto antes de você encosta, e o cristal pega fogo."
 },
 {
  "i": 45,
  "start": 72.687,
  "end": 73.303,
  "text": "Sua vez."
 },
 {
  "i": 46,
  "start": 73.364,
  "end": 74.072,
  "text": "Você encosta..."
 },
 {
  "i": 47,
  "start": 74.103,
  "end": 74.749,
  "text": "e nada."
 },
 {
  "i": 48,
  "start": 74.78,
  "end": 75.672,
  "text": "Nem uma faísca."
 },
 {
  "i": 49,
  "start": 75.703,
  "end": 77.185,
  "text": "A sala inteira cai na gargalhada."
 },
 {
  "i": 50,
  "start": 77.397,
  "end": 80.874,
  "text": "Até que o diretor bate o cajado no chão, e todo mundo cala a boca."
 },
 {
  "i": 51,
  "start": 80.904,
  "end": 85.935,
  "text": "Ele chega perto e fala baixinho, só pra você: O último sem marca foi o meu irmão."
 },
 {
  "i": 52,
  "start": 86.042,
  "end": 88.935,
  "text": "Exilaram ele pro sul, pras terras do Rei Demônio."
 },
 {
  "i": 53,
  "start": 89.042,
  "end": 90.224,
  "text": "Ele nunca mais voltou."
 },
 {
  "i": 54,
  "start": 90.647,
  "end": 92.34,
  "text": "E aí você escuta um miado."
 },
 {
  "i": 55,
  "start": 92.555,
  "end": 94.647,
  "text": "Em cima da estante, te encarando..."
 },
 {
  "i": 56,
  "start": 94.74,
  "end": 96.445,
  "text": "o mesmo gato que você salvou."
 },
 {
  "i": 57,
  "start": 99.769,
  "end": 101.615,
  "text": "Segue a página pra ver o episódio dois!"
 }
]