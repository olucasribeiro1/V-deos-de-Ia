[
 {
  "i": 0,
  "start": 0.787,
  "end": 1.4,
  "text": "Dia trinta."
 },
 {
  "i": 1,
  "start": 1.467,
  "end": 2.4,
  "text": "Onze e meia da manhã."
 },
 {
  "i": 2,
  "start": 2.467,
  "end": 4.267,
  "text": "Trinta minutos pro último helicóptero."
 },
 {
  "i": 3,
  "start": 4.528,
  "end": 6.837,
  "text": "O tio enche a churrasqueira com oito anos de carvão."
 },
 {
  "i": 4,
  "start": 6.871,
  "end": 8.304,
  "text": "Liga o gerador do lado de fora."
 },
 {
  "i": 5,
  "start": 8.337,
  "end": 9.068,
  "text": "E acende."
 },
 {
  "i": 6,
  "start": 9.514,
  "end": 9.986,
  "text": "Vai."
 },
 {
  "i": 7,
  "start": 10.168,
  "end": 11.514,
  "text": "Um apito, para."
 },
 {
  "i": 8,
  "start": 11.695,
  "end": 12.859,
  "text": "Dois, corre."
 },
 {
  "i": 9,
  "start": 13.004,
  "end": 14.251,
  "text": "E não olha pra trás."
 },
 {
  "i": 10,
  "start": 14.618,
  "end": 17.385,
  "text": "Três pessoas e um cachorro, rua abaixo, longe da avenida."
 },
 {
  "i": 11,
  "start": 17.418,
  "end": 18.374,
  "text": "Na metade do caminho..."
 },
 {
  "i": 12,
  "start": 18.395,
  "end": 19.118,
  "text": "a mãe para."
 },
 {
  "i": 13,
  "start": 19.151,
  "end": 19.768,
  "text": "Um apito."
 },
 {
  "i": 14,
  "start": 20.201,
  "end": 23.868,
  "text": "Do outro lado da rua, uma sombra alta atravessa a esquina."
 },
 {
  "i": 15,
  "start": 24.134,
  "end": 24.934,
  "text": "Devagar."
 },
 {
  "i": 16,
  "start": 25.201,
  "end": 26.068,
  "text": "Farejando o ar."
 },
 {
  "i": 17,
  "start": 26.401,
  "end": 28.4,
  "text": "E vira a cabeça na direção de vocês."
 },
 {
  "i": 18,
  "start": 28.767,
  "end": 30.9,
  "text": "Lá atrás, a fumaça da churrasqueira sobe."
 },
 {
  "i": 19,
  "start": 31.034,
  "end": 31.434,
  "text": "Preta."
 },
 {
  "i": 20,
  "start": 31.567,
  "end": 32.034,
  "text": "Quente."
 },
 {
  "i": 21,
  "start": 32.167,
  "end": 32.867,
  "text": "Enorme."
 },
 {
  "i": 22,
  "start": 32.9,
  "end": 33.734,
  "text": "A coisa gira..."
 },
 {
  "i": 23,
  "start": 33.767,
  "end": 34.714,
  "text": "e corre pro calor."
 },
 {
  "i": 24,
  "start": 35.009,
  "end": 35.809,
  "text": "Dois apitos!"
 },
 {
  "i": 25,
  "start": 36.028,
  "end": 36.755,
  "text": "Corre!"
 },
 {
  "i": 26,
  "start": 37.021,
  "end": 37.893,
  "text": "O estádio aparece."
 },
 {
  "i": 27,
  "start": 38.027,
  "end": 39.16,
  "text": "As hélices já girando."
 },
 {
  "i": 28,
  "start": 39.293,
  "end": 39.827,
  "text": "Um minuto."
 },
 {
  "i": 29,
  "start": 39.96,
  "end": 40.76,
  "text": "Trinta segundos."
 },
 {
  "i": 30,
  "start": 40.893,
  "end": 42.227,
  "text": "A porta começa a fechar."
 },
 {
  "i": 31,
  "start": 42.467,
  "end": 43.776,
  "text": "Cadê o tio?!"
 },
 {
  "i": 32,
  "start": 44.243,
  "end": 49.643,
  "text": "E pelo portão do estádio, coberto de fuligem da cabeça aos pés, com um espeto de churrasco na mão..."
 },
 {
  "i": 33,
  "start": 49.71,
  "end": 50.789,
  "text": "vem o tio Osvaldo."
 },
 {
  "i": 34,
  "start": 52.398,
  "end": 55.161,
  "text": "Eu falei que esse bunker ia servir pra alguma coisa."
 },
 {
  "i": 35,
  "start": 56.266,
  "end": 57.938,
  "text": "O vô tinha razão, tio."
 },
 {
  "i": 36,
  "start": 58.047,
  "end": 60.051,
  "text": "Você assistiu filme de zumbi demais."
 },
 {
  "i": 37,
  "start": 61.051,
  "end": 62.069,
  "text": "E ainda bem."
 },
 {
  "i": 38,
  "start": 62.75,
  "end": 63.522,
  "text": "Trinta dias."
 },
 {
  "i": 39,
  "start": 63.689,
  "end": 66.555,
  "text": "Cinco regras que salvaram essa família: abrigo primeiro."
 },
 {
  "i": 40,
  "start": 66.689,
  "end": 67.822,
  "text": "Regra sete-dez."
 },
 {
  "i": 41,
  "start": 67.889,
  "end": 69.455,
  "text": "Água de beber não se raciona."
 },
 {
  "i": 42,
  "start": 69.489,
  "end": 71.039,
  "text": "Gerador só do lado de fora."
 },
 {
  "i": 43,
  "start": 71.055,
  "end": 72.886,
  "text": "E a roupa de fora fica do lado de fora."
 },
 {
  "i": 44,
  "start": 73.62,
  "end": 77.22,
  "text": "Lá embaixo, no quintal vazio, a brasa ainda queima."
 },
 {
  "i": 45,
  "start": 77.253,
  "end": 78.753,
  "text": "E no meio das cinzas..."
 },
 {
  "i": 46,
  "start": 78.853,
  "end": 80.161,
  "text": "alguma coisa se mexe."
 },
 {
  "i": 47,
  "start": 80.694,
  "end": 82.694,
  "text": "A contenção falhou de novo."
 },
 {
  "i": 48,
  "start": 87.033,
  "end": 88.466,
  "text": "Fim da primeira temporada!"
 },
 {
  "i": 49,
  "start": 88.5,
  "end": 91.166,
  "text": "Segue a página e comenta: você teria escutado o tio?"
 }
]