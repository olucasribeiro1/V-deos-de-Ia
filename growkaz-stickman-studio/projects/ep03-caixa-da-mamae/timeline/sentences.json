[
 {
  "i": 0,
  "start": 0.827,
  "end": 2.067,
  "text": "Duas e catorze da manhã."
 },
 {
  "i": 1,
  "start": 2.533,
  "end": 4.267,
  "text": "Alguma coisa arranha o alçapão."
 },
 {
  "i": 2,
  "start": 4.467,
  "end": 5.167,
  "text": "Devagar."
 },
 {
  "i": 3,
  "start": 5.4,
  "end": 5.9,
  "text": "Para."
 },
 {
  "i": 4,
  "start": 6.133,
  "end": 7.133,
  "text": "E arranha de novo."
 },
 {
  "i": 5,
  "start": 7.423,
  "end": 8.223,
  "text": "É o Bilu!"
 },
 {
  "i": 6,
  "start": 8.441,
  "end": 9.678,
  "text": "Gente, é o Bilu!"
 },
 {
  "i": 7,
  "start": 9.823,
  "end": 10.913,
  "text": "Ele achou a gente!"
 },
 {
  "i": 8,
  "start": 11.136,
  "end": 12.227,
  "text": "Tio, abre!"
 },
 {
  "i": 9,
  "start": 12.372,
  "end": 13.463,
  "text": "Só um pouquinho!"
 },
 {
  "i": 10,
  "start": 13.815,
  "end": 16.069,
  "text": "Faz catorze horas que essa bomba caiu."
 },
 {
  "i": 11,
  "start": 16.106,
  "end": 18.324,
  "text": "Lá fora ainda tá fervendo de radiação."
 },
 {
  "i": 12,
  "start": 18.421,
  "end": 19.281,
  "text": "Ninguém abre."
 },
 {
  "i": 13,
  "start": 19.548,
  "end": 22.348,
  "text": "Regra do tio: antes de quarenta e oito horas, porta fechada."
 },
 {
  "i": 14,
  "start": 22.414,
  "end": 24.481,
  "text": "Com dois dias, a radiação cai pra um por cento."
 },
 {
  "i": 15,
  "start": 24.548,
  "end": 25.348,
  "text": "Antes disso..."
 },
 {
  "i": 16,
  "start": 25.381,
  "end": 26.091,
  "text": "é suicídio."
 },
 {
  "i": 17,
  "start": 26.524,
  "end": 28.158,
  "text": "Então ele puxa o periscópio."
 },
 {
  "i": 18,
  "start": 28.358,
  "end": 30.358,
  "text": "Um cano, dois espelhos..."
 },
 {
  "i": 19,
  "start": 30.391,
  "end": 32.1,
  "text": "e um olho no mundo lá fora."
 },
 {
  "i": 20,
  "start": 32.654,
  "end": 33.236,
  "text": "Nada."
 },
 {
  "i": 21,
  "start": 33.491,
  "end": 34.291,
  "text": "Só poeira."
 },
 {
  "i": 22,
  "start": 34.56,
  "end": 36.46,
  "text": "O quintal parece outro planeta."
 },
 {
  "i": 23,
  "start": 36.693,
  "end": 37.593,
  "text": "Tudo cinza."
 },
 {
  "i": 24,
  "start": 37.76,
  "end": 38.76,
  "text": "Nenhum cachorro."
 },
 {
  "i": 25,
  "start": 38.96,
  "end": 39.96,
  "text": "E o arranhão..."
 },
 {
  "i": 26,
  "start": 40.127,
  "end": 40.56,
  "text": "para."
 },
 {
  "i": 27,
  "start": 41.165,
  "end": 41.783,
  "text": "Ótimo."
 },
 {
  "i": 28,
  "start": 41.965,
  "end": 43.856,
  "text": "Agora eu nunca mais durmo."
 },
 {
  "i": 29,
  "start": 44.528,
  "end": 49.295,
  "text": "Vocês cresceram ouvindo o avô Joaquim repetir a mesma piada, todo santo domingo."
 },
 {
  "i": 30,
  "start": 50.295,
  "end": 53.204,
  "text": "Esse menino assistiu filme de zumbi demais!"
 },
 {
  "i": 31,
  "start": 53.571,
  "end": 55.371,
  "text": "O tio passou a vida ouvindo isso."
 },
 {
  "i": 32,
  "start": 55.571,
  "end": 56.804,
  "text": "E nunca respondeu."
 },
 {
  "i": 33,
  "start": 57.037,
  "end": 59.317,
  "text": "Hoje, a piada dói um pouco diferente."
 },
 {
  "i": 34,
  "start": 60.004,
  "end": 60.584,
  "text": "Dia dois."
 },
 {
  "i": 35,
  "start": 60.75,
  "end": 62.284,
  "text": "A mãe dorme pela primeira vez."
 },
 {
  "i": 36,
  "start": 62.317,
  "end": 65.75,
  "text": "E você faz o que filho nenhum devia fazer: abre a mochila dela."
 },
 {
  "i": 37,
  "start": 66.027,
  "end": 67.293,
  "text": "Um crachá militar."
 },
 {
  "i": 38,
  "start": 67.493,
  "end": 68.66,
  "text": "A foto da sua mãe."
 },
 {
  "i": 39,
  "start": 68.893,
  "end": 70.393,
  "text": "Laboratório de Biossegurança."
 },
 {
  "i": 40,
  "start": 70.493,
  "end": 71.493,
  "text": "Acesso restrito."
 },
 {
  "i": 41,
  "start": 71.827,
  "end": 72.893,
  "text": "E um tablet..."
 },
 {
  "i": 42,
  "start": 72.927,
  "end": 73.626,
  "text": "trancado."
 },
 {
  "i": 43,
  "start": 74.044,
  "end": 75.317,
  "text": "Biossegurança?"
 },
 {
  "i": 44,
  "start": 75.572,
  "end": 76.226,
  "text": "Mãe..."
 },
 {
  "i": 45,
  "start": 76.299,
  "end": 77.608,
  "text": "o que você fazia lá?"
 },
 {
  "i": 46,
  "start": 77.987,
  "end": 80.314,
  "text": "Isso não é seu pra mexer, Eduardo."
 },
 {
  "i": 47,
  "start": 80.768,
  "end": 82.313,
  "text": "Então me conta o que é, mãe."
 },
 {
  "i": 48,
  "start": 82.686,
  "end": 84.064,
  "text": "Ela pega o tablet de volta."
 },
 {
  "i": 49,
  "start": 84.109,
  "end": 85.12,
  "text": "As mãos tremendo."
 },
 {
  "i": 50,
  "start": 85.153,
  "end": 87.02,
  "text": "Rápido demais pra quem não tem nada a esconder."
 },
 {
  "i": 51,
  "start": 87.773,
  "end": 90.173,
  "text": "E é nesse silêncio que o arranhão volta."
 },
 {
  "i": 52,
  "start": 90.44,
  "end": 91.44,
  "text": "Só que agora..."
 },
 {
  "i": 53,
  "start": 91.473,
  "end": 92.573,
  "text": "mais pesado."
 },
 {
  "i": 54,
  "start": 92.673,
  "end": 93.522,
  "text": "Arrastado."
 },
 {
  "i": 55,
  "start": 93.94,
  "end": 94.885,
  "text": "É o Bilu..."
 },
 {
  "i": 56,
  "start": 94.994,
  "end": 95.358,
  "text": "né?"
 },
 {
  "i": 57,
  "start": 95.613,
  "end": 96.776,
  "text": "Me diz que é o Bilu."
 },
 {
  "i": 58,
  "start": 97.146,
  "end": 98.812,
  "text": "O tio volta pro periscópio."
 },
 {
  "i": 59,
  "start": 99.012,
  "end": 101.023,
  "text": "E dessa vez, ele não fala nada."
 },
 {
  "i": 60,
  "start": 101.69,
  "end": 104.692,
  "text": "Porque cachorro nenhum tem dois metros de altura."
 },
 {
  "i": 61,
  "start": 109.226,
  "end": 111.292,
  "text": "Segue a página pra ver o episódio quatro!"
 }
]