[
 {
  "i": 0,
  "start": 0.667,
  "end": 1.3,
  "text": "Dia oito."
 },
 {
  "i": 1,
  "start": 1.467,
  "end": 3.8,
  "text": "Todo dia de manhã, o tio faz a conta da água."
 },
 {
  "i": 2,
  "start": 3.867,
  "end": 4.667,
  "text": "E hoje..."
 },
 {
  "i": 3,
  "start": 4.7,
  "end": 5.867,
  "text": "a conta não fecha."
 },
 {
  "i": 4,
  "start": 6.146,
  "end": 7.419,
  "text": "Tá faltando água."
 },
 {
  "i": 5,
  "start": 7.674,
  "end": 8.704,
  "text": "Muita água."
 },
 {
  "i": 6,
  "start": 8.97,
  "end": 11.404,
  "text": "Atrás da prateleira, o chão tá molhado."
 },
 {
  "i": 7,
  "start": 11.637,
  "end": 14.037,
  "text": "Três galões rachados desde a onda de choque da bomba."
 },
 {
  "i": 8,
  "start": 14.437,
  "end": 15.37,
  "text": "Pingando..."
 },
 {
  "i": 9,
  "start": 15.404,
  "end": 16.515,
  "text": "há oito dias."
 },
 {
  "i": 10,
  "start": 16.832,
  "end": 18.547,
  "text": "Eu lavei o cabelo duas vezes..."
 },
 {
  "i": 11,
  "start": 18.583,
  "end": 19.523,
  "text": "isso não conta, né?"
 },
 {
  "i": 12,
  "start": 19.84,
  "end": 20.94,
  "text": "Sobraram cem litros."
 },
 {
  "i": 13,
  "start": 21.04,
  "end": 23.129,
  "text": "Quatro pessoas, quatro litros por dia cada."
 },
 {
  "i": 14,
  "start": 23.15,
  "end": 23.916,
  "text": "Dá seis dias."
 },
 {
  "i": 15,
  "start": 24.298,
  "end": 27.179,
  "text": "Então a partir de hoje, meio copo por pessoa."
 },
 {
  "i": 16,
  "start": 27.635,
  "end": 27.875,
  "text": "Não."
 },
 {
  "i": 17,
  "start": 28.057,
  "end": 30.239,
  "text": "Água de beber não se raciona."
 },
 {
  "i": 18,
  "start": 30.311,
  "end": 33.075,
  "text": "Desidratação derruba mais rápido que fome."
 },
 {
  "i": 19,
  "start": 33.111,
  "end": 34.973,
  "text": "Corta o banho, não o copo."
 },
 {
  "i": 20,
  "start": 35.409,
  "end": 38.956,
  "text": "Regra dos manuais de emergência: uns quatro litros por pessoa, por dia."
 },
 {
  "i": 21,
  "start": 39.056,
  "end": 41.289,
  "text": "Metade pra beber, metade pra comida e higiene."
 },
 {
  "i": 22,
  "start": 41.356,
  "end": 42.889,
  "text": "Na crise, você corta o banho..."
 },
 {
  "i": 23,
  "start": 42.923,
  "end": 44.156,
  "text": "nunca a água de beber."
 },
 {
  "i": 24,
  "start": 44.747,
  "end": 46.201,
  "text": "Seis dias..."
 },
 {
  "i": 25,
  "start": 46.274,
  "end": 47.147,
  "text": "Dia catorze."
 },
 {
  "i": 26,
  "start": 47.51,
  "end": 50.939,
  "text": "O dia em que a radiação lá fora cai pra zero vírgula um por cento."
 },
 {
  "i": 27,
  "start": 51.212,
  "end": 53.357,
  "text": "E a caixa d'água de casa tá tampada!"
 },
 {
  "i": 28,
  "start": 53.539,
  "end": 55.866,
  "text": "A água lá dentro tá protegida da poeira."
 },
 {
  "i": 29,
  "start": 56.244,
  "end": 57.02,
  "text": "O plano nasce ali."
 },
 {
  "i": 30,
  "start": 57.12,
  "end": 58.52,
  "text": "No dia catorze, eles saem."
 },
 {
  "i": 31,
  "start": 58.553,
  "end": 59.32,
  "text": "Vinte minutos."
 },
 {
  "i": 32,
  "start": 59.386,
  "end": 60.32,
  "text": "Até a caixa d'água..."
 },
 {
  "i": 33,
  "start": 60.342,
  "end": 60.914,
  "text": "e de volta."
 },
 {
  "i": 34,
  "start": 61.58,
  "end": 64.847,
  "text": "Mas naquela madrugada, o Eduardo acorda com um sussurro."
 },
 {
  "i": 35,
  "start": 65.184,
  "end": 66.384,
  "text": "A mãe tá no rádio."
 },
 {
  "i": 36,
  "start": 66.584,
  "end": 67.317,
  "text": "Sozinha."
 },
 {
  "i": 37,
  "start": 67.517,
  "end": 68.651,
  "text": "Falando baixinho..."
 },
 {
  "i": 38,
  "start": 68.751,
  "end": 69.451,
  "text": "em código."
 },
 {
  "i": 39,
  "start": 69.833,
  "end": 71.985,
  "text": "Doutora Mariana, Projeto Cérebro."
 },
 {
  "i": 40,
  "start": 72.166,
  "end": 73.439,
  "text": "Quatro sobreviventes."
 },
 {
  "i": 41,
  "start": 73.621,
  "end": 75.003,
  "text": "Abrigo sob a churrasqueira."
 },
 {
  "i": 42,
  "start": 75.148,
  "end": 75.662,
  "text": "Câmbio."
 },
 {
  "i": 43,
  "start": 76.062,
  "end": 77.467,
  "text": "Recebido, doutora."
 },
 {
  "i": 44,
  "start": 77.664,
  "end": 79.115,
  "text": "Permaneça na posição."
 },
 {
  "i": 45,
  "start": 79.278,
  "end": 81.449,
  "text": "Não saia antes do dia catorze."
 },
 {
  "i": 46,
  "start": 81.816,
  "end": 83.616,
  "text": "Ela não tá pedindo socorro."
 },
 {
  "i": 47,
  "start": 83.649,
  "end": 84.892,
  "text": "Tá passando um relatório."
 },
 {
  "i": 48,
  "start": 85.41,
  "end": 86.21,
  "text": "Mãe..."
 },
 {
  "i": 49,
  "start": 86.283,
  "end": 87.81,
  "text": "com quem você tá falando?"
 },
 {
  "i": 50,
  "start": 88.182,
  "end": 89.582,
  "text": "Ela desliga o rádio."
 },
 {
  "i": 51,
  "start": 89.849,
  "end": 90.649,
  "text": "Devagar."
 },
 {
  "i": 52,
  "start": 90.916,
  "end": 92.449,
  "text": "E pela primeira vez..."
 },
 {
  "i": 53,
  "start": 92.549,
  "end": 93.596,
  "text": "ela não mente."
 },
 {
  "i": 54,
  "start": 94.142,
  "end": 96.178,
  "text": "Com quem fez isso, Eduardo."
 },
 {
  "i": 55,
  "start": 97.017,
  "end": 100.219,
  "text": "E agora, eles sabem exatamente onde vocês estão."
 },
 {
  "i": 56,
  "start": 104.753,
  "end": 106.886,
  "text": "Segue a página pra ver o episódio seis!"
 }
]