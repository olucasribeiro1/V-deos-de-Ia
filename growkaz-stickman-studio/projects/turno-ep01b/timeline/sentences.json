[
 {
  "i": 0,
  "start": 1.806,
  "end": 2.926,
  "text": "Me vê um café, filho."
 },
 {
  "i": 1,
  "start": 3.406,
  "end": 5.886,
  "text": "Um louco tentou abrir a porta do caminhão no pedágio."
 },
 {
  "i": 2,
  "start": 6.206,
  "end": 7.599,
  "text": "Me mordeu, acredita?"
 },
 {
  "i": 3,
  "start": 10.604,
  "end": 13.526,
  "text": "Seu Alberto, o senhor precisa de hospital."
 },
 {
  "i": 4,
  "start": 14.246,
  "end": 16.166,
  "text": "Hospital é na cidade, filho."
 },
 {
  "i": 5,
  "start": 16.486,
  "end": 17.766,
  "text": "E a cidade..."
 },
 {
  "i": 6,
  "start": 17.806,
  "end": 18.994,
  "text": "tá pior que eu."
 },
 {
  "i": 7,
  "start": 19.674,
  "end": 21.754,
  "text": "Ele pagou o café e foi embora."
 },
 {
  "i": 8,
  "start": 22.394,
  "end": 23.8,
  "text": "Dois minutos depois..."
 },
 {
  "i": 9,
  "start": 26.289,
  "end": 27.029,
  "text": "Mano..."
 },
 {
  "i": 10,
  "start": 27.103,
  "end": 28.14,
  "text": "isso foi ele."
 },
 {
  "i": 11,
  "start": 29.003,
  "end": 31.723,
  "text": "Quando a fumaça baixou, eu vi."
 },
 {
  "i": 12,
  "start": 31.803,
  "end": 35.003,
  "text": "Na beira do mato, bem onde a luz do posto acaba..."
 },
 {
  "i": 13,
  "start": 35.043,
  "end": 36.443,
  "text": "tinha gente parada."
 },
 {
  "i": 14,
  "start": 36.523,
  "end": 37.883,
  "text": "Olhando pra gente."
 },
 {
  "i": 15,
  "start": 37.923,
  "end": 39.449,
  "text": "Nenhum passava da luz."
 },
 {
  "i": 16,
  "start": 40.271,
  "end": 41.16,
  "text": "Lucas..."
 },
 {
  "i": 17,
  "start": 41.197,
  "end": 43.457,
  "text": "a lâmpada daquele poste tá queimando."
 },
 {
  "i": 18,
  "start": 44.344,
  "end": 46.904,
  "text": "Uma hora depois, bateram no vidro."
 },
 {
  "i": 19,
  "start": 47.144,
  "end": 48.304,
  "text": "Era o Seu Alberto."
 },
 {
  "i": 20,
  "start": 48.504,
  "end": 49.264,
  "text": "Inteiro."
 },
 {
  "i": 21,
  "start": 49.464,
  "end": 50.384,
  "text": "Sem sangue."
 },
 {
  "i": 22,
  "start": 50.584,
  "end": 51.656,
  "text": "Sem curativo."
 },
 {
  "i": 23,
  "start": 53.756,
  "end": 54.876,
  "text": "Me vê um café, filho."
 },
 {
  "i": 24,
  "start": 55.356,
  "end": 57.836,
  "text": "Um louco tentou abrir a porta do caminhão no pedágio."
 },
 {
  "i": 25,
  "start": 58.156,
  "end": 59.549,
  "text": "Me mordeu, acredita?"
 },
 {
  "i": 26,
  "start": 60.129,
  "end": 61.809,
  "text": "Palavra por palavra."
 },
 {
  "i": 27,
  "start": 62.049,
  "end": 63.489,
  "text": "A mesma pausa."
 },
 {
  "i": 28,
  "start": 63.729,
  "end": 65.169,
  "text": "O mesmo acredita."
 },
 {
  "i": 29,
  "start": 65.643,
  "end": 66.236,
  "text": "Ele..."
 },
 {
  "i": 30,
  "start": 66.31,
  "end": 68.178,
  "text": "ele não tava no caminhão que bateu?"
 },
 {
  "i": 31,
  "start": 68.925,
  "end": 70.698,
  "text": "Eu corri pro fundo pegar o cadeado."
 },
 {
  "i": 32,
  "start": 70.858,
  "end": 76.589,
  "text": "E lá do estoque, no escuro, eu ouvi: Coxinha que passa da meia-noite é perda, Lucas."
 },
 {
  "i": 33,
  "start": 76.613,
  "end": 76.636,
  "text": "Eu tô salvando a empresa."
 },
 {
  "i": 34,
  "start": 77.756,
  "end": 79.036,
  "text": "Só que o Tico..."
 },
 {
  "i": 35,
  "start": 79.076,
  "end": 80.205,
  "text": "tava do meu lado."
 },
 {
  "i": 36,
  "start": 83.845,
  "end": 86.325,
  "text": "Segue a página pro episódio dois."
 }
]