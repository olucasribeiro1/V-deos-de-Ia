[
 {
  "i": 0,
  "start": 0.521,
  "end": 3.532,
  "text": "Nesse mundo, existe um anjo que cuida da economia do universo."
 },
 {
  "i": 1,
  "start": 3.564,
  "end": 6.764,
  "text": "E numa segunda-feira, ele resolveu trocar o dinheiro da Terra inteira."
 },
 {
  "i": 2,
  "start": 6.919,
  "end": 8.336,
  "text": "Cortou quatro zeros de tudo."
 },
 {
  "i": 3,
  "start": 8.432,
  "end": 9.872,
  "text": "Salário, preço, poupança."
 },
 {
  "i": 4,
  "start": 9.936,
  "end": 13.073,
  "text": "Ninguém ficou mais pobre: o pão de mil reais virou pão de dez centavos."
 },
 {
  "i": 5,
  "start": 13.39,
  "end": 14.023,
  "text": "Parece loucura?"
 },
 {
  "i": 6,
  "start": 14.183,
  "end": 15.815,
  "text": "O Brasil fez isso de verdade."
 },
 {
  "i": 7,
  "start": 15.847,
  "end": 23.293,
  "text": "Entre mil novecentos e oitenta e seis e mil novecentos e noventa e quatro, a gente teve cinco moedas diferentes: cruzado, cruzado novo, cruzeiro, cruzeiro real..."
 },
 {
  "i": 8,
  "start": 23.314,
  "end": 23.861,
  "text": "e o real."
 },
 {
  "i": 9,
  "start": 24.125,
  "end": 26.253,
  "text": "Só que o anjo esqueceu de converter uma pessoa."
 },
 {
  "i": 10,
  "start": 26.269,
  "end": 26.941,
  "text": "O Guilherme."
 },
 {
  "i": 11,
  "start": 26.973,
  "end": 30.655,
  "text": "Dezenove anos, rei do videogame, e dono da maior conta de fiado da padaria."
 },
 {
  "i": 12,
  "start": 30.973,
  "end": 31.555,
  "text": "Hm..."
 },
 {
  "i": 13,
  "start": 31.773,
  "end": 32.937,
  "text": "deve ser nada."
 },
 {
  "i": 14,
  "start": 33.204,
  "end": 36.788,
  "text": "Na terça de manhã, ele foi comprar pão com a única moeda que tinha: um real."
 },
 {
  "i": 15,
  "start": 36.98,
  "end": 38.175,
  "text": "Só que um real dele..."
 },
 {
  "i": 16,
  "start": 38.218,
  "end": 40.062,
  "text": "valia dez mil reais do dinheiro novo."
 },
 {
  "i": 17,
  "start": 40.453,
  "end": 41.18,
  "text": "Menino..."
 },
 {
  "i": 18,
  "start": 41.398,
  "end": 44.162,
  "text": "com isso aqui tu compra o pão, o forno..."
 },
 {
  "i": 19,
  "start": 44.198,
  "end": 44.889,
  "text": "e eu."
 },
 {
  "i": 20,
  "start": 45.153,
  "end": 49.319,
  "text": "E o bug tinha mais um efeito: todo dia, o dinheiro dele se multiplicava por dez."
 },
 {
  "i": 21,
  "start": 49.447,
  "end": 50.663,
  "text": "Desde que ele não gastasse nada."
 },
 {
  "i": 22,
  "start": 50.727,
  "end": 51.623,
  "text": "Gastou um centavo?"
 },
 {
  "i": 23,
  "start": 51.655,
  "end": 52.516,
  "text": "Trava pra sempre."
 },
 {
  "i": 24,
  "start": 52.896,
  "end": 53.9,
  "text": "Dia um: dez mil."
 },
 {
  "i": 25,
  "start": 53.996,
  "end": 54.636,
  "text": "Ele guarda."
 },
 {
  "i": 26,
  "start": 54.764,
  "end": 56.044,
  "text": "Dia dois: cem mil."
 },
 {
  "i": 27,
  "start": 56.108,
  "end": 57.196,
  "text": "Ele come miojo cru."
 },
 {
  "i": 28,
  "start": 57.26,
  "end": 58.668,
  "text": "Dia três: um milhão."
 },
 {
  "i": 29,
  "start": 58.7,
  "end": 60.204,
  "text": "A mãe dele vende o micro-ondas."
 },
 {
  "i": 30,
  "start": 60.377,
  "end": 62.849,
  "text": "Guilherme, eu juro por Deus..."
 },
 {
  "i": 31,
  "start": 63.181,
  "end": 65.709,
  "text": "Dia quatro: dez milhões de reais."
 },
 {
  "i": 32,
  "start": 65.773,
  "end": 67.117,
  "text": "Num cofrinho de porquinho."
 },
 {
  "i": 33,
  "start": 67.505,
  "end": 70.001,
  "text": "E aí bateu o medo: e se o anjo perceber amanhã?"
 },
 {
  "i": 34,
  "start": 70.385,
  "end": 72.049,
  "text": "O Guilherme, que só sabia jogar..."
 },
 {
  "i": 35,
  "start": 72.081,
  "end": 72.887,
  "text": "jogou certo."
 },
 {
  "i": 36,
  "start": 73.263,
  "end": 74.463,
  "text": "Comprou a padaria do Seu Manoel."
 },
 {
  "i": 37,
  "start": 74.559,
  "end": 75.423,
  "text": "O terreno do lado."
 },
 {
  "i": 38,
  "start": 75.455,
  "end": 76.885,
  "text": "Pagou o fiado da rua inteira."
 },
 {
  "i": 39,
  "start": 76.905,
  "end": 78.714,
  "text": "E o Seu Manoel ganhou um crachá de gerente."
 },
 {
  "i": 40,
  "start": 78.943,
  "end": 80.632,
  "text": "Eu vou ter vale-refeição?"
 },
 {
  "i": 41,
  "start": 80.945,
  "end": 82.166,
  "text": "E ele fez bem em não guardar."
 },
 {
  "i": 42,
  "start": 82.294,
  "end": 87.265,
  "text": "Quando um único cara joga milhões numa rua, o pão é o mesmo, mas tem muito mais dinheiro correndo atrás dele."
 },
 {
  "i": 43,
  "start": 87.308,
  "end": 88.246,
  "text": "O preço sobe."
 },
 {
  "i": 44,
  "start": 88.31,
  "end": 89.206,
  "text": "Isso é inflação."
 },
 {
  "i": 45,
  "start": 89.424,
  "end": 94.582,
  "text": "E o Brasil sabe bem: em mil novecentos e noventa e três, os preços subiram mais de dois mil por cento num ano."
 },
 {
  "i": 46,
  "start": 94.614,
  "end": 96.502,
  "text": "O mercado remarcava a etiqueta todo dia."
 },
 {
  "i": 47,
  "start": 96.534,
  "end": 98.838,
  "text": "Por isso ele trocou o dinheiro por coisa que não derrete."
 },
 {
  "i": 48,
  "start": 99.276,
  "end": 102.476,
  "text": "Naquela noite, o chefe do anjo achou o erro."
 },
 {
  "i": 49,
  "start": 102.58,
  "end": 103.834,
  "text": "Estagiário."
 },
 {
  "i": 50,
  "start": 104.092,
  "end": 104.979,
  "text": "...Ctrl Z?"
 },
 {
  "i": 51,
  "start": 105.508,
  "end": 107.703,
  "text": "De manhã, o real dele voltou a valer um real."
 },
 {
  "i": 52,
  "start": 107.767,
  "end": 108.535,
  "text": "Mas a padaria..."
 },
 {
  "i": 53,
  "start": 108.663,
  "end": 109.501,
  "text": "continuou sendo dele."
 },
 {
  "i": 54,
  "start": 109.869,
  "end": 112.124,
  "text": "Agora quem anota o fiado sou eu."
 },
 {
  "i": 55,
  "start": 112.392,
  "end": 112.84,
  "text": "E você?"
 },
 {
  "i": 56,
  "start": 112.968,
  "end": 115.208,
  "text": "Torrava tudo no primeiro dia ou esperava?"
 },
 {
  "i": 57,
  "start": 115.272,
  "end": 115.84,
  "text": "Comenta aí."
 },
 {
  "i": 58,
  "start": 118.968,
  "end": 120.759,
  "text": "Segue a página pra mais Nesse Mundo!"
 }
]