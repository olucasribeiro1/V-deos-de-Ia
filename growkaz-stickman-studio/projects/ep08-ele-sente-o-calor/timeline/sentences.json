[
 {
  "i": 0,
  "start": 0.723,
  "end": 2.933,
  "text": "Os passos param bem em cima de vocês."
 },
 {
  "i": 1,
  "start": 3.0,
  "end": 4.548,
  "text": "E tudo fica quieto demais."
 },
 {
  "i": 2,
  "start": 4.894,
  "end": 6.166,
  "text": "Ninguém se mexe."
 },
 {
  "i": 3,
  "start": 6.421,
  "end": 7.379,
  "text": "Ninguém fala."
 },
 {
  "i": 4,
  "start": 7.779,
  "end": 11.512,
  "text": "Nem o Rafael, que nunca ficou quieto um minuto na vida inteira."
 },
 {
  "i": 5,
  "start": 11.98,
  "end": 14.314,
  "text": "Alguma coisa testa o alçapão."
 },
 {
  "i": 6,
  "start": 14.58,
  "end": 15.347,
  "text": "Devagar."
 },
 {
  "i": 7,
  "start": 15.58,
  "end": 17.922,
  "text": "Como quem sabe exatamente o que está fazendo."
 },
 {
  "i": 8,
  "start": 18.499,
  "end": 19.749,
  "text": "Ele sente o calor."
 },
 {
  "i": 9,
  "start": 19.967,
  "end": 22.222,
  "text": "Do gerador, da churrasqueira..."
 },
 {
  "i": 10,
  "start": 22.258,
  "end": 22.876,
  "text": "da gente."
 },
 {
  "i": 11,
  "start": 23.313,
  "end": 24.627,
  "text": "Foi pra isso que ele veio."
 },
 {
  "i": 12,
  "start": 25.027,
  "end": 26.099,
  "text": "Então a gente esfria."
 },
 {
  "i": 13,
  "start": 26.281,
  "end": 26.863,
  "text": "Tudo."
 },
 {
  "i": 14,
  "start": 26.936,
  "end": 27.663,
  "text": "Agora."
 },
 {
  "i": 15,
  "start": 28.007,
  "end": 29.086,
  "text": "Gerador, desligado."
 },
 {
  "i": 16,
  "start": 29.22,
  "end": 30.386,
  "text": "Lampião, apagado."
 },
 {
  "i": 17,
  "start": 30.42,
  "end": 31.53,
  "text": "Rádio, sem pilha."
 },
 {
  "i": 18,
  "start": 31.575,
  "end": 34.162,
  "text": "Em dez segundos, o bunker vira um buraco escuro e frio."
 },
 {
  "i": 19,
  "start": 34.529,
  "end": 38.229,
  "text": "Disciplina de abrigo: sem luz, sem barulho, sem cheiro de comida."
 },
 {
  "i": 20,
  "start": 38.262,
  "end": 41.906,
  "text": "E pra não congelar no escuro, todo mundo junto, debaixo das mesmas cobertas."
 },
 {
  "i": 21,
  "start": 41.951,
  "end": 43.399,
  "text": "O corpo de um esquenta o do outro."
 },
 {
  "i": 22,
  "start": 43.945,
  "end": 44.817,
  "text": "Tio..."
 },
 {
  "i": 23,
  "start": 44.89,
  "end": 46.127,
  "text": "eu tô com fome."
 },
 {
  "i": 24,
  "start": 46.547,
  "end": 48.147,
  "text": "Agora não, Rafael."
 },
 {
  "i": 25,
  "start": 48.616,
  "end": 50.949,
  "text": "Lá em cima, as garras arranham a chapa."
 },
 {
  "i": 26,
  "start": 51.282,
  "end": 51.982,
  "text": "Uma vez."
 },
 {
  "i": 27,
  "start": 52.216,
  "end": 53.016,
  "text": "Duas."
 },
 {
  "i": 28,
  "start": 53.116,
  "end": 53.694,
  "text": "Três."
 },
 {
  "i": 29,
  "start": 54.213,
  "end": 56.103,
  "text": "Tio, se isso abrir..."
 },
 {
  "i": 30,
  "start": 56.579,
  "end": 59.522,
  "text": "Então a gente faz o que eu treinei a vida toda pra fazer."
 },
 {
  "i": 31,
  "start": 59.889,
  "end": 64.322,
  "text": "Pela primeira vez, a família toda se move junto, sem precisar combinar."
 },
 {
  "i": 32,
  "start": 64.356,
  "end": 66.389,
  "text": "O tio na escada, com uma barra de ferro."
 },
 {
  "i": 33,
  "start": 66.422,
  "end": 67.922,
  "text": "O Eduardo segurando o irmão."
 },
 {
  "i": 34,
  "start": 67.956,
  "end": 69.171,
  "text": "A mãe com a mão no rádio."
 },
 {
  "i": 35,
  "start": 69.905,
  "end": 71.105,
  "text": "E então..."
 },
 {
  "i": 36,
  "start": 71.171,
  "end": 71.938,
  "text": "nada."
 },
 {
  "i": 37,
  "start": 72.305,
  "end": 73.048,
  "text": "Silêncio."
 },
 {
  "i": 38,
  "start": 73.782,
  "end": 74.682,
  "text": "Uma hora."
 },
 {
  "i": 39,
  "start": 74.982,
  "end": 75.715,
  "text": "Duas."
 },
 {
  "i": 40,
  "start": 75.982,
  "end": 79.248,
  "text": "Os passos vão embora, arrastados, pro lado da rua."
 },
 {
  "i": 41,
  "start": 79.996,
  "end": 84.563,
  "text": "E foi nesse silêncio que você entendeu: a bomba nunca foi o fim da história."
 },
 {
  "i": 42,
  "start": 84.596,
  "end": 85.933,
  "text": "Foi só o primeiro aviso."
 },
 {
  "i": 43,
  "start": 90.56,
  "end": 92.467,
  "text": "Segue a página pra ver o episódio nove!"
 }
]